# T3rnel — example environment file.
# Copy to .env and fill in only what you need. Never commit real values.

# ── LLM providers (at least one required for agent runs) ──────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM-compatible endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# ── Daemon ────────────────────────────────────────────────────────────────────
# Host/port the API server binds to. Default: 127.0.0.1:4200
T3RNEL_HOST=127.0.0.1
T3RNEL_PORT=4200
# Bearer token required for API access when set. Generate a long random value.
T3RNEL_API_TOKEN=

# State directory. Defaults to ~/.t3rnel
# T3RNEL_HOME=

# ── Sandbox / egress ──────────────────────────────────────────────────────────
# Comma-separated domains the sandbox may reach. Empty = allow all (dev only).
# T3RNEL_EGRESS_ALLOWLIST=

# ── Integrations ──────────────────────────────────────────────────────────────
# OAuth / API credentials for bundled integrations are stored in the credential
# vault (AES-256-GCM), not here. See `t3rnel extensions` commands.

# ── Optional services ─────────────────────────────────────────────────────────
# Cloudflare (only if you deploy the license/edge workers yourself)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Android SDK location (mobile builds)
# ANDROID_HOME=
